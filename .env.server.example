TRON_SCAN_LAG_BLOCKS=1
TRON_SCAN_MAX_CATCHUP_BLOCKS=1200
TRON_RECONCILE_SECONDS=300
TRON_FALLBACK_POLL_SECONDS=30
# 监控地址数量不限；对账间隔自适应：max(TRON_RECONCILE_SECONDS, 监控数×7/TRON_RECONCILE_QPS)

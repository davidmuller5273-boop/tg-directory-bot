TRONSCAN_MAX_QPS=3
TRON_CACHE_SECONDS=5
TRON_FALLBACK_NODES=https://api.tronstack.io,https://tron-rpc.publicnode.com
# 扫块监控（仅母机器人扫块，子机器人通过 data/tron-scan.sqlite3 接收匹配结果）

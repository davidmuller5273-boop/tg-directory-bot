BOT_TOKEN=123456:replace_with_botfather_token
# Optional but recommended: enables reliable public @username to numeric ID lookup.
# Create these values at https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
DEVELOPER_IDS=123456789
ADMIN_IDS=987654321
SUPER_ADMIN_IDS=
DB_PATH=data/directory.sqlite3

# Comma-separated categories shown in listings and accepted by /submit.
CATEGORIES=tools,docs,community,market,service,other

# Comma-separated words that submissions must not contain.
BLOCKED_KEYWORDS=赌博,博彩,菠菜,赌场,彩票,casino,betting,sportsbook

# Ordinary bot messages are deleted after 180 seconds. Set 0 to disable.
MESSAGE_AUTO_DELETE_SECONDS=180

# Web admin panel. Keep WEB_HOST on 127.0.0.1 when using Nginx.
WEB_HOST=127.0.0.1
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password
SESSION_SECRET=replace_with_at_least_32_random_characters
BACKUPS_DIR=backups

# TRON mainnet balance provider. Production use should set a TronGrid API key.
TRONGRID_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRONSCAN_API_KEY=
OKLINK_API_KEY=
TOKENVIEW_API_KEY=
TRONSCAN_API_URL=https://apilist.tronscanapi.com

# OKX public pre-login P2P marketplace. This endpoint is not part of OKX V5 API docs.
OKX_P2P_URL=https://www.okx.com/v3/c2c/tradingOrders/getMarketplaceAdsPrelogin

# Fallback reference price provider when the OKX marketplace is unavailable.
COINGECKO_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Official China Welfare Lottery / Sports Lottery draw-result APIs.
CWL_LOTTERY_URL=https://www.cwl.gov.cn/cwl_admin/front/cwlkj/search/kjxx/findDrawNotice
SPORTTERY_LOTTERY_URL=https://webapi.sporttery.cn/gateway/lottery/getHistoryPageListV1.qry
LOTTERY_REALTIME_URL=https://api.api16868.com
LOTTERY_PUBLIC_DATA_BASE_URL=https://raw.githubusercontent.com/wenjinliuu/lottery-data-repo/main/public_data
LOTTERY_POLL_SECONDS=60
